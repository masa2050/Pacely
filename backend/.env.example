# このファイルをコピーして backend/.env を作る:  cp .env.example .env
# .env は .gitignore 済み。実際のキー・シークレットは .env にだけ書き、コミットしない。

# --- ローカルDB (docker-compose.yml と一致させる) ---
DATABASE_URL=postgres://pacely:pacely_local_pw@localhost:5432/pacely?sslmode=disable

# --- サーバ ---
PORT=8080
# CORSで許可するフロントエンドのオリジン。未設定時は http://localhost:5173 (Vite標準ポート)
FRONTEND_ORIGIN=http://localhost:5173

# --- Supabase ---
# Supabaseダッシュボード > Project Settings > API から取得
# バックエンドのJWT検証は SUPABASE_URL から JWKS(公開鍵)エンドポイントを導出して行う。
# 共有シークレット(JWT Secret)は新方式では使わない。
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
# 退会機能(DELETE /users/me)でSupabase Authの管理者APIを呼ぶために使う(docs/adr/014)。
# 取得先: Supabaseダッシュボード > Project Settings > API > service_role key
# 強い権限を持つキーのため、フロントエンドには絶対に渡さないこと。
SUPABASE_SERVICE_ROLE_KEY=

# --- 外部API (フェーズ5) ---
# 開発段階ではGemini APIを使う(docs/adr/002)。本番前にClaude/OpenAIと出力品質を
# 比較して再決定する。取得先: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 取得先: https://openweathermap.org/api (無料枠のCurrent Weather Data)
OPENWEATHERMAP_API_KEY=
