# このファイルをコピーして backend/.env を作る:  cp .env.example .env
# .env は .gitignore 済み。実際のキー・シークレットは .env にだけ書き、コミットしない。

# --- ローカルDB (docker-compose.yml と一致させる) ---
DATABASE_URL=postgres://pacely:pacely_local_pw@localhost:5432/pacely?sslmode=disable

# --- サーバ ---
PORT=8080

# --- Supabase ---
# Supabaseダッシュボード > Project Settings > API / Data API から取得
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
# Project Settings > API > JWT Settings の "JWT Secret" (HS256の共有シークレット)
# バックエンドのJWT検証で使う
SUPABASE_JWT_SECRET=

# --- 外部API (フェーズ5で設定) ---
CLAUDE_API_KEY=
OPENWEATHERMAP_API_KEY=
