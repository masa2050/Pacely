# このファイルをコピーして backend/.env を作る:  cp .env.example .env
# .env は .gitignore 済み。実際のキー・シークレットは .env にだけ書き、コミットしない。

# --- ローカルDB (docker-compose.yml と一致させる) ---
DATABASE_URL=postgres://pacely:pacely_local_pw@localhost:5432/pacely?sslmode=disable

# --- サーバ ---
PORT=8080
# CORSで許可するフロントエンドのオリジン。未設定時は http://localhost:5173 (Vite標準ポート)
FRONTEND_ORIGIN=http://localhost:5173

# --- Supabase ---
# Supabaseダッシュボード > Project Settings > API から取得
# バックエンドのJWT検証は SUPABASE_URL から JWKS(公開鍵)エンドポイントを導出して行う。
# 共有シークレット(JWT Secret)は新方式では使わない。
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=

# --- 外部API (フェーズ5で設定) ---
CLAUDE_API_KEY=
OPENWEATHERMAP_API_KEY=
