# このファイルをコピーして .env を作る: cp .env.example .env
# .env は .gitignore 済み。実際のキーはここではなく .env に書く。

# --- ローカルDB (docker-compose.yml と一致させる) ---
DATABASE_URL=postgres://pacely:pacely_local_pw@localhost:5432/pacely?sslmode=disable

# --- バックエンド (Go) ---
PORT=8080

# --- Supabase (フェーズ0後半 / フェーズ1で設定) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# --- 外部API (フェーズ5で設定) ---
CLAUDE_API_KEY=
OPENWEATHERMAP_API_KEY=
