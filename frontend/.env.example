# このファイルをコピーして frontend/.env を作る:  cp .env.example .env
# Vite では VITE_ 接頭辞の変数だけがフロントに埋め込まれる。
# ここに書く anon key は「公開前提」の鍵なので露出してよい(RLSで保護する)。
# JWT Secret など秘密の値はフロントには絶対に置かない。

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# バックエンドAPIのベースURL(ローカル開発)
VITE_API_BASE_URL=http://localhost:8080
